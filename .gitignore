__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/

# Chainlit runtime (but keep config + custom translations)
.chainlit/*
!.chainlit/config.toml
!.chainlit/translations/
.files/

# RAG data
data/chroma/
data/docs/*
!data/docs/.gitkeep

# Generated at runtime by app registry
public/apps.json

# Runtime-persisted Chainlit element blobs
public/elements/

# Deployment-specific compose override (each env maintains its own,
# e.g. stable sets container_name=*-stable and port 7861:7860)
docker-compose.override.yml

# LiteLLM master config — 含 Tailscale IP，每個部署環境可能不同
# 若團隊需共用 template，提供 litellm-config.example.yaml 作為樣本
# litellm-config.yaml

# IDE
.vscode/
.idea/

# 法規語料 ingest 的中繼快取（重跑不必重花 LLM 的錢，但不進版控）
app/regulations/corpus/.cache/

# Playwright E2E
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/downloads/
tests/e2e/.auth/
