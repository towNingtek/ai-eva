# ----- LLM 後端 -----
# 預設走 OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ----- 切換到既有 Ollama Gateway（OpenAI-相容端點）-----
# OPENAI_API_KEY=dummy
# OPENAI_API_BASE=http://host.docker.internal:8002/v1
# LLM_MODEL=openai/gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# ----- RAG -----
CHROMA_DIR=/app/data/chroma
DOCS_DIR=/app/data/docs
RAG_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ----- Web Search (apps/web_search) -----
# 取得 key: https://tavily.com（免費 1000 次/月）
# 空值 → 自動降級到 DuckDuckGo
TAVILY_API_KEY=
WEB_SEARCH_TOP_K=5

# ----- Auth (Chainlit password auth) -----
# ADMIN_PASS 留空 → 關閉 auth（僅本機 dev）；有值 → 啟用登入頁
# 產生 secret 範例：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CHAINLIT_AUTH_SECRET=
ADMIN_USER=admin
ADMIN_PASS=

# ----- Data Layer (Postgres for chat history / side menu) -----
# 留空 → 關閉持久化；docker compose 用自帶 postgres 服務
DATABASE_URL=postgresql+asyncpg://chainlit:chainlit_local@postgres:5432/chainlit
