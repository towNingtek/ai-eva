# ----- LLM 後端 -----
# 預設走 OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ----- 切換到既有 Ollama Gateway（OpenAI-相容端點）-----
# OPENAI_API_KEY=dummy
# OPENAI_API_BASE=http://host.docker.internal:8002/v1
# LLM_MODEL=openai/gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# ----- Web Search (apps/web_search) -----
# 取得 key: https://tavily.com（免費 1000 次/月）
# 空值 → 自動降級到 DuckDuckGo
TAVILY_API_KEY=
WEB_SEARCH_TOP_K=5

# ----- LiteLLM (M2 LLM gateway) -----
# ai-eva 不直連 OpenAI，全部走 LiteLLM proxy
# LiteLLM container 跑 host network mode（為了能打 Pi5 Tailscale IP）
LITELLM_API_BASE=http://host.docker.internal:4000/v1
LITELLM_DEFAULT_MODEL=cloud-fast       # OpenAI gpt-4o-mini，互動主線
LITELLM_CHEAP_MODEL=local-cheap        # Pi5 Qwen，省錢節點

# M2.5 — Master key 保護 LiteLLM Admin API + UI
# 產法：openssl rand -hex 24，前綴 sk-
# ai-eva 透過 LITELLM_API_KEY 打 LiteLLM；Admin UI 用 admin / <master> 登入
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
# LiteLLM Admin UI 登入密碼（admin / 這個）；空 → 退回用 master key 當密碼
LITELLM_UI_PASSWORD=
# 各 surface 各自一把 virtual key（透過 LiteLLM Admin UI 或 /key/generate API 發）
LITELLM_LINE_KEY=

# ----- NVIDIA NIM (M2.5 多模型對照用，免費 endpoint) -----
# 註冊：https://build.nvidia.com → API Keys（要手機 OTP 驗證）
# 配額：40 RPM；不穩、隨時可能變動，只用在 hello_world 對照
NVIDIA_API_KEY=

# ----- RabbitMQ (M4 cron push) -----
# 產法：openssl rand -hex 16
# ai-eva 容器在同個 docker network，用 rabbitmq:5672；
# 外部 worker（Pi5 cron）走 Tailscale IP:5672 / :5673
RABBITMQ_USER=evapush
RABBITMQ_PASS=
RABBITMQ_URL=amqp://evapush:PASS@rabbitmq:5672/
RABBITMQ_QUEUE=line-push

# ----- Device surface (issue #25 — edge node 整合) -----
# 產法：openssl rand -hex 16
# 空值 → /device/* 端點回 503，不啟用（避免裸跑）
# node 帶 X-Device-Token header 才能 register / intent / result
DEVICE_SURFACE_TOKEN=
# 影像公開來源（LINE 抓圖用）；要是能被 LINE 從外網拉到的 HTTPS hostname。
# 空值 → 影像仍會落地但 LINE 抓不到圖（本機 dev 正常）
DEVICE_PUBLIC_BASE=
# 用例 C：LINE 來的裝置指令派給哪個 project 的 node（暫用單一 project）
LINE_DEVICE_PROJECT=home

# ----- opencode serve bridge（LINE / Discord 語音共用）-----
# 有值 → LINE / Discord 對話改路由到 opencode serve（記憶在 opencode session 那側）
# 空值 → 停用，LINE 走原本 LiteLLM 路徑
OPENCODE_SERVE_BASE=
OPENCODE_SERVE_USER=
OPENCODE_SERVE_PASS=
# 例 litellm/local-cheap；空 → litellm/cloud-fast
OPENCODE_MODEL=
# 新 session 固定 title；空 → LINE 用「LINE:<使用者名稱>」
OPENCODE_SESSION_TITLE=
# 圖片的 host 側目錄（container /app/data ↔ host data/ 共享；opencode server 跑 host 要 host 路徑）
# 例 /home/you/ai-eva/data/line-images
OPENCODE_IMAGE_HOST_DIR=
# 圖片訊息的 vision 模型策略（litellm/OpenAI-compatible 在 opencode 吃圖有 bug）
OPENCODE_VISION_MODEL=anthropic/claude-haiku-4-5
OPENCODE_VISION_PROVIDERS=anthropic,openai,google
OPENCODE_VISION_MODELS=

# ----- Discord 語音 surface（ai-cat-discord-voice bot 打進來）-----
# bot repo: https://github.com/towNingtek/ai-cat-discord-voice
# 產法：openssl rand -hex 16；空值 → /discord-voice/chat 回 503，不啟用
DISCORD_VOICE_TOKEN=
# Discord 語音要共用的 opencode session id（例：跟 LINE ai-cat 同一個 → 跨 surface 連續記憶）
# 空 → 每個語音頻道自建 session
OPENCODE_SHARED_SESSION_ID=

# ----- LINE Bot (M3) -----
# LINE Developers Console → Messaging API channel
# 空值 → /webhook/line 端點回 503，不啟用
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ----- Auth (Chainlit password auth) -----
# ADMIN_PASS 留空 → 關閉 auth（僅本機 dev）；有值 → 啟用登入頁
# 產生 secret 範例：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CHAINLIT_AUTH_SECRET=
ADMIN_USER=admin
ADMIN_PASS=

# ----- Data Layer (Postgres for chat history / side menu) -----
# 留空 → 關閉持久化；docker compose 用自帶 postgres 服務
DATABASE_URL=postgresql+asyncpg://chainlit:chainlit_local@postgres:5432/chainlit
